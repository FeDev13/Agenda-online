# Public Supabase values. These are safe to expose to browser code.
# Local Supabase defaults after `pnpm db:start` are shown as placeholders.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-remote-publishable-key

# Server-only values. Never prefix privileged values with NEXT_PUBLIC_.
# Required only for local administrative scripts, Supabase CLI workflows, or future server-only jobs.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-for-admin-scripts-only
SUPABASE_DB_PASSWORD=replace-with-local-or-hosted-database-password

# Application defaults.
NEXT_PUBLIC_APP_NAME=Agenda Legal
DEFAULT_FIRM_TIMEZONE=America/Argentina/Buenos_Aires
APP_BASE_URL=http://localhost:3000
FIRM_BOOTSTRAP_TOKEN=replace-with-long-random-bootstrap-token

# Deadline email alerts. Keep all values server-only.
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL="Agenda Legal <alerts@example.com>"
RESEND_REPLY_TO_EMAIL=support@example.com
DEADLINE_ALERT_CRON_SECRET=replace-with-at-least-24-random-characters
